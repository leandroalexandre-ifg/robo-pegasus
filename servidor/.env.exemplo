# Copie para ~/.config/robo-pegasus/pegasus.env (ou exporte no shell).
# Todos os valores abaixo são os padrões; só defina o que quiser mudar.

PEGASUS_LLM_URL=http://127.0.0.1:8101/v1
PEGASUS_LLM_CHAVE=EMPTY
# Vazio: usa o primeiro modelo listado em /v1/models
PEGASUS_MODELO=
PEGASUS_LLM_MAX_TOKENS=150
PEGASUS_LLM_TEMPERATURA=0.7
# Turnos anteriores da sessão no histórico do LLM (0 desliga a memória)
PEGASUS_MEMORIA_TURNOS=6
# Como o LLM escolhe a emoção do rosto (definir_emocao):
#   antes    a fala chama a ferramenta antes de escrever (prompt em persona/emocao.md)
#   paralelo requisição própria com a ferramenta obrigatória, em paralelo com a fala
PEGASUS_EMOCAO_MODO=antes
# Modo paralelo: quanto o primeiro áudio pode esperar pela emoção; depois disso vai neutro
PEGASUS_EMOCAO_ESPERA_MS=1000

PEGASUS_WHISPER_MODELO=large-v3-turbo
PEGASUS_WHISPER_DISPOSITIVO=cuda
# Índice físico da GPU. Nunca use 0 (SciTech Ear).
PEGASUS_WHISPER_GPU=1
PEGASUS_WHISPER_PRECISAO=float16
PEGASUS_WHISPER_IDIOMA=pt
PEGASUS_WHISPER_BEAM=1
# Vocabulário esperado pelo Whisper; vazio desliga
PEGASUS_WHISPER_PROMPT=robô, Pegasus
# PEGASUS_WHISPER_CACHE=/caminho/para/modelos/hub

# PEGASUS_PIPER_VOZ=/caminho/para/modelos/piper/pt_BR-faber-medium.onnx

# Silero VAD: a escuta termina sozinha depois deste silêncio (sem listen_stop)
PEGASUS_VAD_SILENCIO_MS=600
# Probabilidade de fala a partir da qual um bloco conta como fala
PEGASUS_VAD_LIMIAR=0.5
# Escuta sem nenhuma fala por este tempo volta a ocioso
PEGASUS_VAD_SEM_FALA_MS=8000

# Servidor WebSocket
PEGASUS_HOST=127.0.0.1
PEGASUS_PORTA_API=8100
# Tokens aceitos no hello, separados por vírgula (um por tablet). Vazio recusa todos.
PEGASUS_TOKENS=
